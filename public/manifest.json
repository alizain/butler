{
	"action": {
		"default_icon": {
			"16": "icons/mug-hot-16.png",
			"32": "icons/mug-hot-32.png",
			"48": "icons/mug-hot-48.png",
			"128": "icons/mug-hot-128.png"
		},
		"default_popup": "entrypoints/popup.html",
		"default_title": "Send to Workflowy"
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"chrome_url_overrides": {
		"newtab": "entrypoints/newtab.html"
	},
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Ctrl+Shift+O",
				"mac": "Command+Shift+O"
			}
		},
		"open-links": {
			"description": "Open links from Workflowy",
			"suggested_key": {
				"default": "Ctrl+Shift+P",
				"mac": "Command+Shift+P"
			}
		}
	},
	"content_scripts": [
		{
			"all_frames": true,
			"js": ["copy-on-select.js"],
			"matches": ["https://*/*"],
			"run_at": "document_start"
		}
	],
	"description": "my personal things",
	"host_permissions": ["https://workflowy.com/*"],
	"icons": {
		"16": "icons/logo-16.png",
		"32": "icons/logo-32.png",
		"48": "icons/logo-48.png",
		"128": "icons/logo-128.png"
	},
	"manifest_version": 3,
	"name": "butler",
	"permissions": ["tabs", "clipboardWrite", "contextMenus", "storage", "alarms"],
	"version": "3.1.0"
}
